# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/lesefluss

# Better Auth - generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=changeme_replace_with_random_hex

# Base URL of the deployed site (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# Catalog service — base URL (no trailing slash) and shared admin bearer token.
# Server-only; CATALOG_ADMIN_SECRET must never reach the browser.
CATALOG_URL=http://localhost:2999
CATALOG_ADMIN_SECRET=

# Optional GlitchTip/Sentry-compatible error tracking.
# VITE_SENTRY_DSN is public and enables browser error reporting.
# SENTRY_DSN is server-only and enables SSR/API error reporting.
VITE_SENTRY_DSN=
SENTRY_DSN=

# Browser extension store listings. When set, the landing page renders enabled
# install buttons. When empty, the buttons render as disabled "Coming soon".
VITE_CHROME_EXTENSION_URL=https://chromewebstore.google.com/detail/lesefluss/pkiibeadmochdpmbbpmjaoogmcgocnho
VITE_FIREFOX_EXTENSION_URL=https://addons.mozilla.org/en-US/firefox/addon/lesefluss/

# Optional: keys the opaque origin identifier books carry on pull. Falls back to a
# key derived from BETTER_AUTH_SECRET. Rotating it changes every key at once.
ORIGIN_KEY_SECRET=

RESEND_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional. Base64 of a Firebase service-account JSON (Project settings > Service accounts).
# Without it the server runs without push notifications and queues nothing.
FIREBASE_SERVICE_ACCOUNT_BASE64=
