{
	"appId": "app.lesefluss",
	"appName": "Lesefluss",
	"webDir": "dist",
	"plugins": {
		"CapacitorSQLite": {
			"androidIsEncryption": false
		},
		"SplashScreen": {
			"launchShowDuration": 8000,
			"launchAutoHide": true,
			"backgroundColor": "#fef6e4",
			"androidScaleType": "CENTER_CROP"
		},
		"StatusBar": {
			"overlaysWebView": true,
			"style": "DARK",
			"backgroundColor": "#00000000"
		},
		"LocalNotifications": {
			"smallIcon": "ic_stat_lesefluss",
			"iconColor": "#d9543a"
		}
	}
}
