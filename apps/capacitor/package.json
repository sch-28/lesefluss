{
	"name": "lesefluss",
	"version": "1.5.5",
	"description": "Lesefluss companion app",
	"type": "module",
	"keywords": [
		"capacitor",
		"mobile"
	],
	"scripts": {
		"dev": "vite",
		"start": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"setup:web": "node scripts/setup-web.mjs",
		"sync": "pnpm run build && cap sync",
		"android": "pnpm run sync && cap run android --target 39131FDJG00AEF && adb logcat Capacitor/Console:I *:S | grep --line-buffered '\\[Lesefluss\\]' | sed -u 's/.* E Capacitor\\/Console:.*Msg: /\\x1b[31m/;s/.* W Capacitor\\/Console:.*Msg: /\\x1b[33m/;s/.*Msg: //;s/$/\\x1b[0m/'",
		"android-raw": "pnpm run sync && cap run android && adb logcat Capacitor/Console:I *:S | grep --line-buffered '\\[Lesefluss\\]' | sed -u 's/.* E Capacitor\\/Console:.*Msg: /\\x1b[31m/;s/.* W Capacitor\\/Console:.*Msg: /\\x1b[33m/;s/.*Msg: //;s/$/\\x1b[0m/'",
		"studio": "cap open android",
		"check-types": "tsc --noEmit && vitest run",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"test:live": "vitest run --config vitest.live.config.ts",
		"ionic:serve": "vite --host 0.0.0.0 --port 3000",
		"ionic:build": "vite build",
		"live": "node scripts/live-reload.mjs",
		"deploy": "node scripts/deploy.mjs",
		"build:apk": "dotenv -e .env.deploy -- sh -c 'pnpm build && cap sync android && cd android && ./gradlew assembleRelease'",
		"deploy:apk": "pnpm build:apk && adb install -r android/app/build/outputs/apk/release/app-release.apk",
		"build:aab": "dotenv -e .env.deploy -- sh -c 'pnpm build && cap sync android && cd android && ./gradlew bundleRelease'",
		"gen-icons": "node scripts/gen-icons.mjs",
		"setup": "node scripts/setup-web.mjs && node scripts/gen-icons.mjs",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"biome": "biome check --write ."
	},
	"dependencies": {
		"@capacitor-community/bluetooth-le": "^8.1.3",
		"@capacitor-community/sqlite": "^8.0.1",
		"@capacitor/android": "^8.5.0",
		"@capacitor/app": "^8.1.0",
		"@capacitor/browser": "^8.0.3",
		"@capacitor/camera": "^8.2.0",
		"@capacitor/clipboard": "^8.0.1",
		"@capacitor/core": "^8.5.0",
		"@capacitor/filesystem": "^8.1.2",
		"@capacitor/keyboard": "8.0.3",
		"@capacitor/preferences": "8.0.1",
		"@capacitor/share": "^8.0.1",
		"@capacitor/splash-screen": "^8.0.1",
		"@capacitor/status-bar": "8.0.2",
		"@capawesome/capacitor-file-picker": "^8.0.2",
		"@lesefluss/ble-config": "workspace:*",
		"@lesefluss/book-import": "workspace:*",
		"@lesefluss/core": "workspace:*",
		"@lesefluss/ui": "workspace:*",
		"@mozilla/readability": "^0.6.0",
		"@nivo/bar": "^0.99.0",
		"@nivo/core": "^0.99.0",
		"@nivo/line": "^0.99.0",
		"@tailwindcss/vite": "^4.2.2",
		"@tanstack/react-query": "^5.95.2",
		"@tanstack/react-router": "^1.170.4",
		"better-auth": "^1.6.3",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"crc-32": "^1.2.2",
		"dompurify": "3.4.0",
		"drizzle-orm": "^0.45.1",
		"epubjs": "^0.3.93",
		"framer-motion": "^12.38.0",
		"jeep-sqlite": "^2.8.0",
		"lucide-react": "1.8.0",
		"pdfjs-dist": "^5.6.205",
		"radix-ui": "1.4.3",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"sonner": "2.0.7",
		"sql.js": "1.11.0",
		"tailwind-merge": "^2.6.1",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "1.4.0",
		"virtua": "^0.48.8"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.0",
		"@playwright/test": "^1.60.0",
		"@tanstack/router-plugin": "^1.168.6",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.2.0",
		"dotenv-cli": "11.0.0",
		"drizzle-kit": "^0.31.10",
		"happy-dom": "^20.9.0",
		"jszip": "^3.10.1",
		"typescript": "^6.0.2",
		"vite": "^7.3.1",
		"vitest": "^4.1.5"
	},
	"author": "",
	"license": "ISC"
}
