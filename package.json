{
	"name": "lesefluss",
	"version": "1.4.1",
	"description": "",
	"main": "index.js",
	"scripts": {
		"setup:project": "turbo run setup && pnpm gen-icons",
		"gen-icons": "bash scripts/gen-icons.sh",
		"release": "bash scripts/release.sh",
		"test": "echo \"Error: no test specified\" && exit 1",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"biome": "biome check --write .",
		"check-python": "python -m compileall -q apps/esp32/boot.py apps/esp32/main.py apps/esp32/src",
		"check-types": "biome check . && turbo run check-types && pnpm check-python",
		"rsvpnano:build": "pio run -d apps/rsvpnano -e waveshare_esp32s3_usb_msc",
		"rsvpnano:upload": "pio run -d apps/rsvpnano -e waveshare_esp32s3_usb_msc -t upload",
		"rsvpnano:monitor": "pio device monitor -d apps/rsvpnano -b 115200",
		"rsvpnano:flash": "pnpm rsvpnano:build && pnpm rsvpnano:upload && pnpm rsvpnano:monitor"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.24.0",
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"turbo": "^2.8.20"
	}
}
